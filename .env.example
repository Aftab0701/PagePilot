# PagePilot Configuration
# Copy this file to .env and fill in your values

# Logging Configuration
PAGEPILOT_LOGGING_LEVEL=info
PAGEPILOT_DEBUG_LOG_FILE=debug.log
PAGEPILOT_INFO_LOG_FILE=info.log

# Protocol logging level
CDP_LOGGING_LEVEL=WARNING

# Telemetry and Analytics
ANONYMIZED_TELEMETRY=true

# API Key Configuration
PAGEPILOT_API_KEY=your_pagepilot_api_key_here

# Alternative LLM Provider Keys (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# Browser Configuration
# PAGEPILOT_EXECUTABLE_PATH=/path/to/chrome
# PAGEPILOT_HEADLESS=false
# PAGEPILOT_USER_DATA_DIR=./browser_data

# Proxy Configuration (Optional)
# PAGEPILOT_PROXY_SERVER=http://proxy.example.com:8080
# PAGEPILOT_NO_PROXY=localhost,127.0.0.1,*.internal
# PAGEPILOT_PROXY_USERNAME=username
# PAGEPILOT_PROXY_PASSWORD=password
