# Fast Dockerfile using pre-built base images
ARG REGISTRY=pagepilot
ARG BASE_TAG=latest
FROM ${REGISTRY}/base-python-deps:${BASE_TAG}

LABEL name="pagepilot" description="Browser automation for AI agents"

ENV PAGEPILOT_USER="pagepilot" DEFAULT_PUID=911 DEFAULT_PGID=911 DATA_DIR=/data

# Create user and directories
RUN groupadd --system $PAGEPILOT_USER && \
    useradd --system --create-home --gid $PAGEPILOT_USER --groups audio,video $PAGEPILOT_USER && \
    usermod -u "$DEFAULT_PUID" "$PAGEPILOT_USER" && \
    groupmod -g "$DEFAULT_PGID" "$PAGEPILOT_USER" && \
    mkdir -p /data /home/$PAGEPILOT_USER/.config && \
    ln -s $DATA_DIR /home/$PAGEPILOT_USER/.config/pagepilot && \
    mkdir -p "/home/$PAGEPILOT_USER/.config/chromium/Crash Reports/pending/" && \
    mkdir -p "$DATA_DIR/profiles/default" && \
    chown -R "$PAGEPILOT_USER:$PAGEPILOT_USER" "/home/$PAGEPILOT_USER" "$DATA_DIR"

WORKDIR /app
COPY . /app

# Install pagepilot
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --all-extras --locked --no-dev --compile-bytecode

USER "$PAGEPILOT_USER"
VOLUME "$DATA_DIR"
EXPOSE 9242 9222
ENTRYPOINT ["pagepilot"]
